# Database
# Local development uses SQLite. The Prisma schema is provider-swappable:
# for a Vercel deploy, point this at a hosted Postgres (Neon, Supabase) and
# change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# AI Documentation Assistant (optional)
# Without a key, the Letter of Medical Necessity falls back to a deterministic,
# well-formatted templated draft. No key is required to run or demo the app.
ANTHROPIC_API_KEY=

# Model id for the Letter of Medical Necessity generator. Any current Claude
# model id works; kept configurable so you can swap tiers without code changes.
ANTHROPIC_MODEL=claude-opus-4-8
